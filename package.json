{
  "name": "hostel-management",
  "version": "2.0.0",
  "description": "Hostel Management System - Vite + Express + Neon Postgres (Prisma)",
  "main": "server/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
 
"scripts": {
  "start": "node server/index.js",
  "server": "nodemon server/index.js",
  "client": "npm start --prefix frontend",
  "vercel-build": "npm install --prefix frontend --include=dev && npx prisma generate && npm run build --prefix frontend",
  "build": "npm run build --prefix frontend",
  "postinstall": "prisma generate"
},
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-handler": "^1.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "prisma": "^6.5.0"
  }
}
