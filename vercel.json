
{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/users/:path*",
      "destination": "/api/users/:path*"
    },
    {
      "source": "/student/:path*",
      "destination": "/api/student/:path*"
    },
    {
      "source": "/attendance/:path*",
      "destination": "/api/attendance/:path*"
    },
    {
      "source": "/menu/:path*",
      "destination": "/api/menu/:path*"
    },
    {
      "source": "/complaints/:path*",
      "destination": "/api/complaints/:path*"
    },
    {
      "source": "/leaves/:path*",
      "destination": "/api/leaves/:path*"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
